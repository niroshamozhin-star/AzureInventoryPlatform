@model IReadOnlyList<InventoryListItem>
@{
    ViewData["Title"] = "Inventory";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Inventory</h1>
    <a class="btn btn-primary" asp-action="Create">+ New Inventory Record</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Warehouse</th>
            <th>Product</th>
            <th class="text-end">Quantity</th>
            <th class="text-end">Reorder Level</th>
            <th>Status</th>
            <th>Last Updated</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr class="@(item.IsLowStock ? "table-warning" : "")">
                <td>@item.WarehouseName</td>
                <td>@item.ProductName</td>
                <td class="text-end">@item.Quantity.ToString("N0")</td>
                <td class="text-end">@item.ReorderLevel.ToString("N0")</td>
                <td>
                    @if (item.IsLowStock)
                    {
                        <span class="badge bg-warning text-dark">Low stock</span>
                    }
                    else
                    {
                        <span class="badge bg-success">OK</span>
                    }
                </td>
                <td>@item.LastUpdated.ToString("yyyy-MM-dd")</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Adjust" asp-route-id="@item.Id">Adjust</a>
                    <form asp-action="Delete" asp-route-id="@item.Id" class="d-inline"
                          onsubmit="return confirm('Delete this inventory record?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="7" class="text-center text-muted">No inventory records yet.</td></tr>
        }
    </tbody>
</table>
