@model Product
@{
    ViewData["Title"] = "Delete Product";
}

<h1>Delete Product</h1>

<div class="alert alert-warning">Are you sure you want to delete this product?</div>

<dl class="row col-md-6">
    <dt class="col-sm-3">Product Code</dt>
    <dd class="col-sm-9">@Model.ProductCode</dd>
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.ProductName</dd>
    <dt class="col-sm-3">Unit Price</dt>
    <dd class="col-sm-9">@Model.UnitPrice.ToString("C")</dd>
    <dt class="col-sm-3">Reorder Level</dt>
    <dd class="col-sm-9">@Model.ReorderLevel.ToString("N0")</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>
