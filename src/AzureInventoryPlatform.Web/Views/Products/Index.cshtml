@model IReadOnlyList<Product>
@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Products</h1>
    <a class="btn btn-primary" asp-action="Create">+ New Product</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Image</th>
            <th>Product Code</th>
            <th>Name</th>
            <th class="text-end">Unit Price</th>
            <th class="text-end">Reorder Level</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                    {
                        <img src="@product.ImageUrl" alt="@product.ProductName" style="height: 48px;" class="img-thumbnail" />
                    }
                    else
                    {
                        <span class="text-muted small">No image</span>
                    }
                </td>
                <td>@product.ProductCode</td>
                <td>@product.ProductName</td>
                <td class="text-end">@product.UnitPrice.ToString("C")</td>
                <td class="text-end">@product.ReorderLevel.ToString("N0")</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@product.Id">Edit</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@product.Id">Delete</a>
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="6" class="text-center text-muted">No products yet.</td></tr>
        }
    </tbody>
</table>
