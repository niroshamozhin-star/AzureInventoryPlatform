@model IReadOnlyList<WarehouseStockSummary>
@{
    ViewData["Title"] = "Inventory by Warehouse";
}

<h1 class="mb-4">Inventory by Warehouse</h1>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Warehouse</th>
            <th class="text-end">Total Units</th>
            <th class="text-end">Total Value</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Model)
        {
            <tr>
                <td>@row.WarehouseName</td>
                <td class="text-end">@row.TotalUnits.ToString("N0")</td>
                <td class="text-end">@row.TotalValue.ToString("C")</td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="3" class="text-center text-muted">No stock recorded yet.</td></tr>
        }
    </tbody>
</table>
