@model IReadOnlyList<WarehouseStockSummary>
@{
    ViewData["Title"] = "Reports";
    var lowStock = (IReadOnlyList<LowStockAlert>)ViewBag.LowStock;
}

<h1 class="mb-4">Reports</h1>

<h2 class="h4">Stock Summary by Warehouse</h2>
<table class="table table-striped align-middle mb-5">
    <thead>
        <tr>
            <th>Warehouse</th>
            <th class="text-end">Total Units</th>
            <th class="text-end">Total Value</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Model)
        {
            <tr>
                <td>@row.WarehouseName</td>
                <td class="text-end">@row.TotalUnits.ToString("N0")</td>
                <td class="text-end">@row.TotalValue.ToString("C")</td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="3" class="text-center text-muted">No stock recorded yet.</td></tr>
        }
    </tbody>
</table>

<h2 class="h4">Low Stock Alerts</h2>
<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Product</th>
            <th>Warehouse</th>
            <th class="text-end">Qty On Hand</th>
            <th class="text-end">Reorder Level</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var alert in lowStock)
        {
            <tr class="table-warning">
                <td>@alert.ProductName</td>
                <td>@alert.WarehouseName</td>
                <td class="text-end">@alert.Quantity.ToString("N0")</td>
                <td class="text-end">@alert.ReorderLevel.ToString("N0")</td>
            </tr>
        }
        @if (lowStock.Count == 0)
        {
            <tr><td colspan="4" class="text-center text-muted">Nothing below reorder level.</td></tr>
        }
    </tbody>
</table>
