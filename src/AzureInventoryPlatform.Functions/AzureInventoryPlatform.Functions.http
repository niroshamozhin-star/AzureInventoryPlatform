# (unlike local dev, which allows it anonymously). Get the key from:
# niro-inventory-functions -> App keys -> _master, and paste it below.
POST {{LiveHostAddress}}/admin/functions/LowStockTimerCheck?code=PASTE_MASTER_KEY_HERE
Content-Type: application/json

