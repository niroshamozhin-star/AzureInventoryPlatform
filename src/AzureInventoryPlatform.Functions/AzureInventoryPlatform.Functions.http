@HostAddress = http://localhost:7179

### 1. Get a JWT token (HTTP trigger: GetToken)
POST {{HostAddress}}/api/auth/token
Content-Type: application/json

{
  "username": "admin",
  "password": "Learn-Az204!"
}

### 2. Call the low-stock report (HTTP trigger: GetLowStockReport)
# Paste the "token" value from request #1's response into @token below before sending (no quotes around it).
@token = PASTE_TOKEN_HERE

GET {{HostAddress}}/api/reports/low-stock
Authorization: Bearer {{token}}

### 3. Negative test - should return 401 (no Authorization header)
GET {{HostAddress}}/api/reports/low-stock

### 4. Manually fire the Timer trigger right now (LowStockTimerCheck)
# Result appears in the Output window, not here - this request will just return 202/200.
POST {{HostAddress}}/admin/functions/LowStockTimerCheck
Content-Type: application/json

{
  "input": ""
}

################################################################################
## Same four requests, against the live Azure Function App.
## The Portal's own Test/Run panel blocks a custom Authorization header, so use
## these instead - Visual Studio's "Send Request" link has no such restriction.
################################################################################

@LiveHostAddress = https://niro-inventory-functions-dsbebyfch0g2c3gj.centralindia-01.azurewebsites.net

### 5. Get a JWT token (live)
POST {{LiveHostAddress}}/api/auth/token
Content-Type: application/json

{
  "username": "admin",
  "password": "Learn-Az204!"
}

