<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AzureFunctionsVersion>V4</AzureFunctionsVersion>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>9397f591-eb6b-41af-95fc-4d9c0c8bcad5</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Storage.Blobs" Version="6.8.1" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Timer" Version="4.3.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.22.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.1.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.0.7" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.10" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
  </ItemGroup>

  <!--
    The nested WorkerExtensions build (produces bin/.../.azurefunctions) declares
    Azure.Storage.Queues 12.24.0 -> System.Memory.Data 8.0.1 in its own deps.json,
    but its build never actually copies System.Memory.Data.dll into that folder.
    The Blob trigger's queue-based poison-blob tracking loads Azure.Storage.Queues
    at startup, which then fails to load its own missing dependency and crashes
    the whole host. Copying the correct version in after every build closes that gap.
  -->
  <Target Name="FixMissingSystemMemoryDataInWorkerExtensions" AfterTargets="Build;Publish">
    <PropertyGroup>
      <_SystemMemoryDataSource>$(NuGetPackageRoot)system.memory.data\8.0.1\lib\net8.0\System.Memory.Data.dll</_SystemMemoryDataSource>
      <_AzureFunctionsExtensionsDir>$(OutDir).azurefunctions\</_AzureFunctionsExtensionsDir>
    </PropertyGroup>
    <Copy SourceFiles="$(_SystemMemoryDataSource)" DestinationFolder="$(_AzureFunctionsExtensionsDir)" SkipUnchangedFiles="true" Condition="Exists('$(_SystemMemoryDataSource)') AND Exists('$(_AzureFunctionsExtensionsDir)')" />
  </Target>

</Project>
